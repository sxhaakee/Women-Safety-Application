# SheSafe Environment Variables

# ── Supabase (get from supabase.com > Project Settings > API) ─────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyYOUR_ANON_KEY

# Service-role key: NEVER expose to client. Only in Edge Functions / Vercel server env.
SUPABASE_SERVICE_ROLE_KEY=eyYOUR_SERVICE_ROLE_KEY

# ── Web App (Vercel) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyYOUR_ANON_KEY

# ── Feature Flags ──────────────────────────────────────────────────────────
EXPO_PUBLIC_DEMO_MODE=false

# ── Nominatim (geocoding) ──────────────────────────────────────────────────
NOMINATIM_USER_AGENT=SheSafe/1.0 (contact@example.com)

# ── OSRM (routing) ────────────────────────────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org
